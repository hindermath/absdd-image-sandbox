{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/specs/002-gsdb-baseline-assessment/contracts/validation-results.schema.json",
  "title": "GSDB-Validierungsergebnis / GSDB Validation Result",
  "description": "DE: Strukturvertrag fuer ausgefuehrte Assessment-Gates und Rueckverfolgung. EN: Structural contract for executed assessment gates and traceability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdAt",
    "reviewedRepositoryRevision",
    "assessmentResultsSha256",
    "acceptedInputBindings",
    "outputBindings",
    "validationResultsPath",
    "gateResults",
    "traceabilitySample",
    "observedCounts",
    "traceabilityTotalSeconds",
    "overallResult",
    "assessmentStateResult"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "createdAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "reviewedRepositoryRevision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "const": "WORKTREE"
        }
      ]
    },
    "assessmentResultsSha256": {
      "$ref": "#/$defs/sha256"
    },
    "acceptedInputBindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hashBinding"
      }
    },
    "outputBindings": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hashBinding"
      }
    },
    "validationResultsPath": {
      "const": "docs/security/secure-development/2026-08-30-gsdb-baseline-assessment/validation-results.json"
    },
    "gateResults": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/gateResult"
      }
    },
    "traceabilitySample": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/traceabilityRecord"
      }
    },
    "observedCounts": {
      "$ref": "#/$defs/observedCounts"
    },
    "traceabilityTotalSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800
    },
    "overallResult": {
      "enum": ["Pass", "Fail", "Blocked"]
    },
    "assessmentStateResult": {
      "enum": ["Draft", "ReviewPending"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overallResult": { "const": "Pass" }
        },
        "required": ["overallResult"]
      },
      "then": {
        "properties": {
          "assessmentStateResult": { "const": "ReviewPending" },
          "observedCounts": {
            "properties": {
              "errorCounts": { "$ref": "#/$defs/zeroErrorCounts" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "assessmentStateResult": { "const": "Draft" }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!N/A$)(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "role": {
      "enum": [
        "Repository Maintainer",
        "Project Owner",
        "Security Review",
        "Platform Owner/Admin",
        "Privacy/Legal Review",
        "CISO/ISB/KIB",
        "Learning/A11Y Review"
      ]
    },
    "hashBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "applicability",
        "executedCommand",
        "runnerOrPlatform",
        "startedAt",
        "finishedAt",
        "exitCode",
        "result",
        "expectedResult",
        "observedResult",
        "evidencePath",
        "limitations",
        "inputSha256",
        "outputSha256",
        "rationale",
        "reevaluationTrigger"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "applicability": {
          "enum": ["Applicable", "N/A"]
        },
        "executedCommand": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "runnerOrPlatform": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "startedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "exitCode": {
          "oneOf": [
            { "type": "integer" },
            { "const": "N/A" }
          ]
        },
        "result": {
          "enum": ["Pass", "Fail", "Skipped", "Blocked"]
        },
        "expectedResult": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "observedResult": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "evidencePath": {
          "oneOf": [
            { "$ref": "#/$defs/repositoryPath" },
            { "const": "N/A" }
          ]
        },
        "limitations": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "inputSha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "const": "N/A" }
          ]
        },
        "outputSha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "const": "N/A" }
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "reevaluationTrigger": {
          "$ref": "#/$defs/nonEmptyText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": { "const": "N/A" }
            },
            "required": ["applicability"]
          },
          "then": {
            "properties": {
              "result": { "const": "Skipped" },
              "exitCode": { "const": "N/A" },
              "executedCommand": { "const": "N/A" },
              "rationale": { "not": { "const": "N/A" } },
              "reevaluationTrigger": { "not": { "const": "N/A" } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": { "const": "Applicable" },
              "result": { "const": "Pass" }
            },
            "required": ["applicability", "result"]
          },
          "then": {
            "properties": {
              "exitCode": { "const": 0 },
              "executedCommand": { "not": { "const": "N/A" } },
              "evidencePath": { "$ref": "#/$defs/repositoryPath" }
            }
          }
        }
      ]
    },
    "traceabilityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checklistId",
        "clId",
        "assessmentStatus",
        "evidenceIds",
        "gapId",
        "startedAt",
        "finishedAt",
        "durationSeconds",
        "reviewerRole",
        "result"
      ],
      "properties": {
        "checklistId": {
          "type": "string",
          "pattern": "^CL-(0[1-9]|1[0-2])$"
        },
        "clId": {
          "type": "string",
          "pattern": "^CL-(0[1-9]|1[0-2])-[0-9]{2}$"
        },
        "assessmentStatus": {
          "enum": ["Applicable", "AlreadySatisfied", "N/A", "Open", "FollowUp"]
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-[A-Z0-9-]+$"
          }
        },
        "gapId": {
          "oneOf": [
            { "type": "string", "pattern": "^GAP-[0-9]{3,}$" },
            { "const": "N/A" }
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        },
        "reviewerRole": {
          "$ref": "#/$defs/role"
        },
        "result": {
          "const": "Pass"
        }
      }
    },
    "observedCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checklists",
        "matrixRows",
        "uniqueClIds",
        "gaps",
        "inventoryItems",
        "errorCounts"
      ],
      "properties": {
        "checklists": { "const": 12 },
        "matrixRows": { "const": 157 },
        "uniqueClIds": { "const": 157 },
        "gaps": { "type": "integer", "minimum": 0 },
        "inventoryItems": { "type": "integer", "minimum": 29 },
        "errorCounts": {
          "$ref": "#/$defs/errorCounts"
        }
      }
    },
    "errorCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missingIds",
        "duplicateIds",
        "extraIds",
        "invalidStatusCombinations",
        "missingMandatoryFields",
        "unsupportedPositiveAssessments",
        "unassignedGapRows",
        "orphanGapMappings",
        "unassignedOwners",
        "indefiniteTriggers",
        "scopeViolations",
        "missingEnglishPartners",
        "unexplainedTerms",
        "visualOnlyInformation",
        "unexplainedCefrDeviations"
      ],
      "properties": {
        "missingIds": { "type": "integer", "minimum": 0 },
        "duplicateIds": { "type": "integer", "minimum": 0 },
        "extraIds": { "type": "integer", "minimum": 0 },
        "invalidStatusCombinations": { "type": "integer", "minimum": 0 },
        "missingMandatoryFields": { "type": "integer", "minimum": 0 },
        "unsupportedPositiveAssessments": { "type": "integer", "minimum": 0 },
        "unassignedGapRows": { "type": "integer", "minimum": 0 },
        "orphanGapMappings": { "type": "integer", "minimum": 0 },
        "unassignedOwners": { "type": "integer", "minimum": 0 },
        "indefiniteTriggers": { "type": "integer", "minimum": 0 },
        "scopeViolations": { "type": "integer", "minimum": 0 },
        "missingEnglishPartners": { "type": "integer", "minimum": 0 },
        "unexplainedTerms": { "type": "integer", "minimum": 0 },
        "visualOnlyInformation": { "type": "integer", "minimum": 0 },
        "unexplainedCefrDeviations": { "type": "integer", "minimum": 0 }
      }
    },
    "zeroErrorCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missingIds",
        "duplicateIds",
        "extraIds",
        "invalidStatusCombinations",
        "missingMandatoryFields",
        "unsupportedPositiveAssessments",
        "unassignedGapRows",
        "orphanGapMappings",
        "unassignedOwners",
        "indefiniteTriggers",
        "scopeViolations",
        "missingEnglishPartners",
        "unexplainedTerms",
        "visualOnlyInformation",
        "unexplainedCefrDeviations"
      ],
      "properties": {
        "missingIds": { "const": 0 },
        "duplicateIds": { "const": 0 },
        "extraIds": { "const": 0 },
        "invalidStatusCombinations": { "const": 0 },
        "missingMandatoryFields": { "const": 0 },
        "unsupportedPositiveAssessments": { "const": 0 },
        "unassignedGapRows": { "const": 0 },
        "orphanGapMappings": { "const": 0 },
        "unassignedOwners": { "const": 0 },
        "indefiniteTriggers": { "const": 0 },
        "scopeViolations": { "const": 0 },
        "missingEnglishPartners": { "const": 0 },
        "unexplainedTerms": { "const": 0 },
        "visualOnlyInformation": { "const": 0 },
        "unexplainedCefrDeviations": { "const": 0 }
      }
    }
  }
}
