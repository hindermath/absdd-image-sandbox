    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryId",
        "category",
        "displayNameDe",
        "displayNameEn",
        "expectedClassification",
        "expectedVersionOrPin",
        "requiredCountGroup",
        "reconciliationStatus",
        "observations",
        "gapId"
      ],
      "properties": {
        "inventoryId": {
          "type": "string",
          "pattern": "^INV-[A-Z0-9-]+$"
        },
        "category": {
          "enum": [
            "MSLToolchain",
            "ScriptingFoundation",
            "AdditionalTool",
            "RequiredAgent",
            "AdditionalAgentSurface",
            "BindingPreset",
            "AdditionalPreset"
          ]
        },
        "displayNameDe": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "displayNameEn": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "expectedClassification": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "expectedVersionOrPin": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "requiredCountGroup": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "reconciliationStatus": {
          "enum": [
            "Aligned",
            "Mismatch",
            "Missing",
            "Open"
          ]
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inventoryObservation"
          }
        },
        "gapId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^GAP-[0-9]{3,}$"
            },
            {
              "const": "N/A"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reconciliationStatus": { "const": "Aligned" }
            },
            "required": ["reconciliationStatus"]
          },
          "then": {
            "properties": {
              "gapId": { "const": "N/A" }
            }
          },
          "else": {
            "properties": {
              "gapId": {
                "type": "string",
                "pattern": "^GAP-[0-9]{3,}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "enum": [
                  "RequiredAgent",
                  "AdditionalAgentSurface"
                ]
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "observations": {
                "allOf": [
                  { "contains": { "properties": { "dimension": { "const": "Installation" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "VersionPin" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "VersionCheck" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "State" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "Dispatcher" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "ProviderSignIn" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "DocumentationCategory" } }, "required": ["dimension"] } }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "enum": [
                  "BindingPreset",
                  "AdditionalPreset"
                ]
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "observations": {
                "allOf": [
                  { "contains": { "properties": { "dimension": { "const": "PresetIdentity" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "PresetVersion" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "PresetPriority" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "PresetEnabled" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "PresetResolution" } }, "required": ["dimension"] } },
                  { "contains": { "properties": { "dimension": { "const": "PresetCoverage" } }, "required": ["dimension"] } }
                ]
              }
            }
          }
        }
      ]
    },
    "inventory": {
      "type": "object",
