        "dimension": {
          "enum": [
            "TargetClaim",
            "Installation",
            "VersionPin",
            "VersionCheck",
            "State",
            "Dispatcher",
            "ProviderSignIn",
            "DocumentationCategory",
            "PresetIdentity",
            "PresetVersion",
            "PresetPriority",
            "PresetEnabled",
            "PresetResolution",
            "PresetCoverage"
          ]
        },
        "sourceKind": {
          "enum": [
            "TargetClaim",
            "Dockerfile",
            "ComposeMount",
            "StateVolume",
            "Registry",
            "VersionCheck",
            "SmokeTest",
            "Dispatcher",
            "Documentation",
            "InstalledPreset"
          ]
        },
        "sourcePath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sourceReference": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "observedCategory": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "observedVersionOrValue": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "command": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "result": {
          "enum": [
            "Pass",
            "Fail",
            "Skipped",
            "Open"
          ]
        },
        "checkedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "platform": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "limitations": {
          "$ref": "#/$defs/nonEmptyText"
        }
      }
