{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "platformAutomerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies",
    "security"
  ],
  "enabledManagers": [
    "custom.regex",
    "dockerfile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9._-]+) depName=(?<depName>[^\\s]+)(?: packageName=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))? argName=(?<argName>[A-Z][A-Z0-9_]*)\\s+ARG [A-Z][A-Z0-9_]*=(?<currentValue>[^\\s]+)"
      ],
      "depTypeTemplate": "dockerfile-arg"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["mcr.microsoft.com/dotnet/sdk"],
      "allowedVersions": "/^10\\.0$/"
    },
    {
      "matchPackageNames": ["java", "java-jdk"],
      "extractVersion": "^v?(?<version>[0-9]+)(?:\\.|$)",
      "allowedVersions": "/^25$/"
    },
    {
      "matchPackageNames": ["node"],
      "extractVersion": "^v?(?<version>[0-9]+)(?:\\.|$)",
      "allowedVersions": "/^24$/"
    },
    {
      "matchPackageNames": ["npm"],
      "allowedVersions": "/^12\\./"
    },
    {
      "matchPackageNames": ["lycheeverse/lychee"],
      "extractVersion": "^lychee-v(?<version>.*)$"
    },
    {
      "matchPackageNames": ["python", "astral-sh/python-build-standalone"],
      "groupName": "Python runtime Dockerfile ARGs"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepTypes": [
        "dockerfile-arg"
      ],
      "addLabels": [
        "dockerfile-arg"
      ],
      "commitMessageTopic": "{{depName}} Dockerfile ARG"
    },
    {
      "matchPackageNames": [
        "golang.org/x/tools/gopls",
        "honnef.co/go/tools",
        "golang.org/x/vuln",
        "github.com/go-delve/delve"
      ],
      "groupName": "Go tooling Dockerfile ARGs",
      "addLabels": [
        "go"
      ]
    },
    {
      "matchPackageNames": [
        "@opencode/cli",
        "@openai/codex",
        "@anthropic-ai/claude-code",
        "@google/gemini-cli",
        "google-antigravity/antigravity-cli",
        "@github/copilot"
      ],
      "groupName": "agent CLI Dockerfile ARGs",
      "addLabels": [
        "agent-tools"
      ]
    },
    {
      "matchPackageNames": [
        "rust",
        "rust-lang/rustup"
      ],
      "groupName": "Rust tooling Dockerfile ARGs",
      "addLabels": [
        "rust"
      ]
    },
    {
      "matchPackageNames": [
        "swift"
      ],
      "groupName": "Swift tooling Dockerfile ARGs",
      "addLabels": [
        "swift"
      ]
    },
    {
      "matchPackageNames": [
        "anchore/syft"
      ],
      "groupName": "supply-chain tooling Dockerfile ARGs",
      "addLabels": [
        "supply-chain",
        "sbom"
      ]
    },
    {
      "matchPackageNames": [
        "PowerShell/PowerShell"
      ],
      "groupName": "PowerShell Dockerfile ARG",
      "addLabels": [
        "powershell",
        "toolchain"
      ]
    },
    {
      "matchPackageNames": [
        "rhysd/actionlint",
        "dotnet-sdk"
      ],
      "groupName": "sandbox validation tooling Dockerfile ARGs",
      "addLabels": [
        "toolchain",
        "validation"
      ]
    }
  ]
}
