{
  "$schema": "https://opencode.ai/config.json",
  // DE: Keine Sitzungsfreigabe und keine unkontrollierten Updates.
  // EN: Disable session sharing and uncontrolled updates.
  "share": "disabled",
  "update": "disable",

  // DE: Kein API-Key, Provider oder Modell ist voreingestellt.
  // EN: No API key, provider or model is preselected.
  // DE: Reihenfolge erhalten: Die letzte passende Regel gewinnt.
  // EN: Preserve order: the last matching rule wins.
  // DE: shell/subagent ersetzen bash/task aus OpenCode 1.
  // EN: shell/subagent replace OpenCode 1 bash/task.
  // DE: Erweiterungsaktionen bleiben vorsorglich erhalten. doom_loop und lsp
  //     sind keine garantierten Core-Kontrollen in V2; siehe Upgrade-Nachweis.
  // EN: Retain extension actions defensively. doom_loop and lsp are not
  //     guaranteed V2 Core controls; see the upgrade evidence.
  "permissions": [
    {"action":"*","resource":"*","effect":"ask"},
    {"action":"read","resource":"*","effect":"allow"},
    {"action":"read","resource":"*.env","effect":"deny"},
    {"action":"read","resource":"*.env.*","effect":"deny"},
    {"action":"read","resource":"**/*.env","effect":"deny"},
    {"action":"read","resource":"**/*.env.*","effect":"deny"},
    {"action":"read","resource":".env","effect":"deny"},
    {"action":"read","resource":"**/.env","effect":"deny"},
    {"action":"read","resource":"opencode.env","effect":"deny"},
    {"action":"read","resource":"**/opencode.env","effect":"deny"},
    {"action":"read","resource":"codex.env","effect":"deny"},
    {"action":"read","resource":"**/codex.env","effect":"deny"},
    {"action":"read","resource":"$HOME/.ssh/**","effect":"deny"},
    {"action":"read","resource":"$HOME/.gnupg/**","effect":"deny"},
    {"action":"read","resource":"$HOME/.config/gh/**","effect":"deny"},
    {"action":"read","resource":"$HOME/.config/glab-cli/**","effect":"deny"},
    {"action":"read","resource":"$HOME/.config/containers/**","effect":"deny"},
    {"action":"read","resource":"$HOME/.local/share/containers/**","effect":"deny"},
    {"action":"read","resource":"$HOME/.codex/**","effect":"deny"},
    {"action":"read","resource":"$HOME/.local/share/opencode/**","effect":"deny"},
    {"action":"read","resource":".env.example","effect":"allow"},
    {"action":"read","resource":"**/.env.example","effect":"allow"},
    {"action":"read","resource":"*.env.example","effect":"allow"},
    {"action":"read","resource":"**/*.env.example","effect":"allow"},
    {"action":"glob","resource":"*","effect":"allow"},
    {"action":"grep","resource":"*","effect":"allow"},
    {"action":"list","resource":"*","effect":"allow"},
    {"action":"edit","resource":"*","effect":"ask"},
    {"action":"edit","resource":"*.env","effect":"deny"},
    {"action":"edit","resource":"*.env.*","effect":"deny"},
    {"action":"edit","resource":"**/*.env","effect":"deny"},
    {"action":"edit","resource":"**/*.env.*","effect":"deny"},
    {"action":"edit","resource":".env","effect":"deny"},
    {"action":"edit","resource":"**/.env","effect":"deny"},
    {"action":"edit","resource":"opencode.env","effect":"deny"},
    {"action":"edit","resource":"**/opencode.env","effect":"deny"},
    {"action":"edit","resource":"codex.env","effect":"deny"},
    {"action":"edit","resource":"**/codex.env","effect":"deny"},
    {"action":"edit","resource":"$HOME/.ssh/**","effect":"deny"},
    {"action":"edit","resource":"$HOME/.gnupg/**","effect":"deny"},
    {"action":"edit","resource":"$HOME/.config/gh/**","effect":"deny"},
    {"action":"edit","resource":"$HOME/.config/glab-cli/**","effect":"deny"},
    {"action":"edit","resource":"$HOME/.config/containers/**","effect":"deny"},
    {"action":"edit","resource":"$HOME/.local/share/containers/**","effect":"deny"},
    {"action":"edit","resource":"$HOME/.codex/**","effect":"deny"},
    {"action":"edit","resource":"$HOME/.local/share/opencode/**","effect":"deny"},
    {"action":"shell","resource":"*","effect":"ask"},
    {"action":"shell","resource":"pwd","effect":"allow"},
    {"action":"shell","resource":"ls","effect":"allow"},
    {"action":"shell","resource":"ls *","effect":"allow"},
    {"action":"shell","resource":"git status","effect":"allow"},
    {"action":"shell","resource":"git status *","effect":"allow"},
    {"action":"shell","resource":"git diff","effect":"allow"},
    {"action":"shell","resource":"git diff *","effect":"allow"},
    {"action":"shell","resource":"git log","effect":"allow"},
    {"action":"shell","resource":"git log *","effect":"allow"},
    {"action":"shell","resource":"git show","effect":"allow"},
    {"action":"shell","resource":"git show *","effect":"allow"},
    {"action":"shell","resource":"git branch","effect":"allow"},
    {"action":"shell","resource":"git branch *","effect":"allow"},
    {"action":"shell","resource":"git remote","effect":"allow"},
    {"action":"shell","resource":"git remote *","effect":"allow"},
    {"action":"shell","resource":"git commit *","effect":"ask"},
    {"action":"shell","resource":"git push *","effect":"ask"},
    {"action":"shell","resource":"podman *","effect":"ask"},
    {"action":"shell","resource":"podman-compose *","effect":"ask"},
    {"action":"shell","resource":"dotnet *","effect":"ask"},
    {"action":"shell","resource":"mvn *","effect":"ask"},
    {"action":"shell","resource":"npm *","effect":"ask"},
    {"action":"shell","resource":"npx *","effect":"ask"},
    {"action":"shell","resource":"curl *","effect":"ask"},
    {"action":"shell","resource":"wget *","effect":"ask"},
    {"action":"shell","resource":"python *","effect":"ask"},
    {"action":"shell","resource":"python3 *","effect":"ask"},
    {"action":"shell","resource":"chmod *","effect":"ask"},
    {"action":"shell","resource":"chown *","effect":"ask"},
    {"action":"shell","resource":"rm *","effect":"deny"},
    {"action":"shell","resource":"sudo *","effect":"deny"},
    {"action":"shell","resource":"su *","effect":"deny"},
    {"action":"shell","resource":"dd *","effect":"deny"},
    {"action":"shell","resource":"mkfs *","effect":"deny"},
    {"action":"shell","resource":"mount *","effect":"deny"},
    {"action":"shell","resource":"umount *","effect":"deny"},
    {"action":"shell","resource":"ssh *","effect":"ask"},
    {"action":"shell","resource":"scp *","effect":"ask"},
    {"action":"shell","resource":"rsync *","effect":"ask"},
    {"action":"external_directory","resource":"*","effect":"ask"},
    {"action":"external_directory","resource":"/ade-dev-sandbox/**","effect":"allow"},
    {"action":"external_directory","resource":"/opt/home-baseline/**","effect":"allow"},
    {"action":"external_directory","resource":"/home/adedev/home-baseline-source/**","effect":"allow"},
    {"action":"external_directory","resource":"/home/adedev/home-baseline-tmp/**","effect":"allow"},
    {"action":"external_directory","resource":"/tmp/opencode/*","effect":"allow"},
    {"action":"external_directory","resource":"/home/adedev/.local/share/opencode/tool-output/*","effect":"allow"},
    {"action":"webfetch","resource":"*","effect":"ask"},
    {"action":"websearch","resource":"*","effect":"ask"},
    {"action":"codesearch","resource":"*","effect":"ask"},
    {"action":"subagent","resource":"*","effect":"ask"},
    {"action":"skill","resource":"*","effect":"ask"},
    {"action":"lsp","resource":"*","effect":"ask"},
    {"action":"todowrite","resource":"*","effect":"allow"},
    {"action":"doom_loop","resource":"*","effect":"ask"},
    {"action":"question","resource":"*","effect":"deny"},
    {"action":"repo_clone","resource":"*","effect":"deny"},
    {"action":"repo_overview","resource":"*","effect":"deny"}
  ]
}
