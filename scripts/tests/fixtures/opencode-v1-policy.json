      "wget *": "ask",
      "python *": "ask",
      "python3 *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "mount *": "deny",
      "umount *": "deny",
