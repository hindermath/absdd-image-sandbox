    {
      "arg": "TINYMIST_VERSION",
      "group": "TINYMIST_VERSION",
      "package": "Myriad-Dreamin/tinymist",
      "provider": "github",
      "tagPrefix": "v",
      "tagSuffix": "",
      "hashVariable": "checksum",
      "algorithm": "sha256",
      "assets": {
        "amd64": "tinymist-x86_64-unknown-linux-gnu.tar.gz",
        "arm64": "tinymist-aarch64-unknown-linux-gnu.tar.gz"
      }
    },
    {
      "arg": "NPM_VERSION",
      "group": "NPM_VERSION",
      "package": "npm",
      "provider": "npm",
      "tagPrefix": "",
      "tagSuffix": "",
      "channel": "12"
    }
  ]
}
